# ==============================================================================
# ELVORA HEALTH ENVIRONMENT CONFIGURATION
# ==============================================================================

# Data Mode:
# 'demo' -> Uses robust localStorage repository with realistic mock clinic data
# 'api'  -> Connects to production FastAPI REST backend
VITE_DATA_MODE=demo

# FastAPI REST Backend Base URL (used when VITE_DATA_MODE=api)
VITE_API_URL=http://localhost:8000/api/v1

# Clinic Default Locale and Currency
VITE_DEFAULT_LOCALE=uz-UZ
VITE_DEFAULT_CURRENCY=UZS
VITE_TIMEZONE=Asia/Tashkent
