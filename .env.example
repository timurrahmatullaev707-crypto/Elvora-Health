# ==============================================================================
# ELVORA HEALTH ENVIRONMENT CONFIGURATION
# ==============================================================================

# Data Mode:
# 'demo' -> Uses robust localStorage repository with realistic mock clinic data
# 'api'  -> Connects to production FastAPI REST backend
VITE_DATA_MODE=demo

# FastAPI REST Backend Base URL (used when VITE_DATA_MODE=api)
VITE_API_URL=http://localhost:8000/api/v1

# Clinic Default Locale and Currency
VITE_DEFAULT_LOCALE=uz-UZ
VITE_DEFAULT_CURRENCY=UZS
VITE_TIMEZONE=Asia/Tashkent

# ==============================================================================
# ELVORA AI™ BACKEND CONFIGURATION (Vercel & Local Node Server)
# ==============================================================================
# Security: These variables are ONLY read on the backend server.
# NEVER prefix secret keys with VITE_ to prevent browser exposure.

# Google Gemini API Key (Recommended, fast & medical reasoning)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative)
# Get a key from: https://platform.openai.com/
OPENAI_API_KEY=

# Rate Limit per client IP per minute (default: 30)
AI_RATE_LIMIT_PER_MINUTE=30

# ==============================================================================
# TELEGRAM BOT & NOTIFICATION AUTOMATION
# ==============================================================================
# Create bot with @BotFather on Telegram (e.g. /newbot -> @ElvoraHealthBot)
# Bot Token from BotFather: (NEVER expose to frontend)
TELEGRAM_BOT_TOKEN=

# Bot username without @ symbol (e.g. ElvoraHealthBot)
TELEGRAM_BOT_USERNAME=ElvoraHealthBot

# Frontend deep link bot username (publicly safe)
VITE_TELEGRAM_BOT_USERNAME=ElvoraHealthBot

# Vercel Cron or webhook authorization secret (optional)
CRON_SECRET=elvora_production_cron_secret
